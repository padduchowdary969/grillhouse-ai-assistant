# Copy to .env and fill in. .env is git-ignored and never copied into an image.
GRILLHOUSE_PASSWORD=choose-a-chat-password
POSTGRES_PASSWORD=choose-a-database-password
GRILLHOUSE_READONLY_PASSWORD=choose-another-password
# Long random string for signing sign-in tokens, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
GRILLHOUSE_JWT_SECRET=replace-with-a-long-random-string
